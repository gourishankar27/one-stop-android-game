{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "server": {"format": "%(levelname)s %(name)s %(message)s"},
    "connection": {"format": "%(levelname)s event=%(message)s generation=%(generation)s request_id=%(request_id)s operation=%(operation)s error_code=%(error_code)s close_code=%(close_code)s duration_ms=%(duration_ms)s"}
  },
  "handlers": {
    "server": {"class": "logging.StreamHandler", "formatter": "server", "stream": "ext://sys.stderr"},
    "connection": {"class": "logging.StreamHandler", "formatter": "connection", "stream": "ext://sys.stderr"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["server"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": ["server"], "level": "INFO", "propagate": false},
    "one_job.connections": {"handlers": ["connection"], "level": "INFO", "propagate": false}
  }
}
